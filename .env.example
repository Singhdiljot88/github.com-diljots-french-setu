# French Setu — environment variables. Copy to .env.local and fill in what you have.
# Nothing here is required: with no keys the app runs in demo mode with a local database.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres / Supabase connection string. If unset, an embedded Postgres (PGlite) stores data in PGLITE_DIR.
DATABASE_URL=
# "require" for hosted Postgres that needs TLS (Supabase, Neon, Render).
DATABASE_SSL=
DATABASE_POOL_MAX=5
# Run migrations and content seeding automatically at startup (default true).
AUTO_MIGRATE=true
# Embedded database folder when DATABASE_URL is empty. Use memory:// for a throw-away database.
PGLITE_DIR=.data/pglite

# ── AI (writing feedback, speaking partner, lessons from web pages) ──────────
# anthropic | openai | demo. If unset, the first provider with a key is used; with no key: demo (rule-based, labelled "not AI").
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 for Anthropic.
AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_DAILY_LIMIT_PER_USER=60
AI_TIMEOUT_MS=60000

# ── Speech ──────────────────────────────────────────────────────────────────
# Text-to-speech: device (browser voice, default) | azure | openai
TTS_PROVIDER=
# Speech-to-text: browser (default) | openai | azure
STT_PROVIDER=
# Pronunciation scoring is only shown when Azure is configured. "none" turns it off.
PRONUNCIATION_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Web discovery ───────────────────────────────────────────────────────────
# brave | tavily | none. Without a key, Discover offers curated official links and paste-your-own-text.
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
# Set to true only when serving production over plain http on a LAN (cookies are otherwise Secure).
INSECURE_COOKIES=
# Folder with days/, dictionary/, mocks/ (default ./content).
CONTENT_DIR=
# Optional model overrides for OpenAI speech
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
